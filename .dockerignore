# Keep the build context small: `target/` alone is several GB.
target/
dist/
out/
.git/
.gitignore

# Never bake a signing key into an image layer.
android/keystore/
*.jks
*.keystore

README.md

# Coolify writes the deployment's environment, secrets included, into the
# build directory. Nothing copies it today; this keeps it that way.
.env
.env.*
